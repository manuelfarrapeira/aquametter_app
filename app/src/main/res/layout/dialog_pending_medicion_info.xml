<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtPendingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medición pendiente de envío"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtPendingMedicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medición: 1234.5 m³"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtPendingConsumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consumo: 123 litros"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtPendingDias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Días: 30"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/txtPendingExceso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exceso: 50 litros"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver foto"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp"/>

</LinearLayout>

